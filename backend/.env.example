SECRET_KEY=change-this-to-a-random-secret-in-production
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
PAYSTACK_SECRET_KEY=
FRONTEND_BASE_URL=http://localhost:5173
# Gmail SMTP for sending signup verification codes. Leave unset locally —
# codes are printed to the server console instead of emailed.
# SMTP_USERNAME is the Gmail address; SMTP_PASSWORD is a 16-character
# "App Password" (requires 2-Step Verification enabled on that account),
# not the normal account password.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Leave unset locally to use a local sqlite file. In production, set this to
# your Render Postgres "Internal Database URL" so data survives redeploys.
DATABASE_URL=
